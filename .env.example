# LIVE AI ---------------------------------------------------------
# Choose: gemini, anthropic, OR openai
AI_PROVIDER=gemini

# Google Gemini (Recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI (used only when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# SUPABASE --------------------------------------------------------
# Public browser values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required only for Stripe webhook entitlement persistence.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Stripe subscription checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_INSTITUTIONAL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional LMS integrations --------------------------------------
# Google Classroom requires teacher/admin OAuth consent and the coursework scope.
GOOGLE_CLASSROOM_ACCESS_TOKEN=

# Canvas requires an institution Canvas URL and access token.
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=
